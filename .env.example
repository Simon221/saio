# Base de données (docker compose expose Postgres sur le port 5434)
DATABASE_URL="postgresql://saio:saio@localhost:5434/saio?schema=public"

# Clé de signature des sessions (JWT). Générer avec: openssl rand -base64 32
AUTH_SECRET="change-me-with-a-long-random-string"

# Compte administrateur créé au premier seed
SEED_ADMIN_EMAIL="admin@saio.sn"
SEED_ADMIN_PASSWORD="ChangeMoi123!"
SEED_ADMIN_NAME="Administrateur SAIO"

# URL publique du site (utilisée pour les liens absolus)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
